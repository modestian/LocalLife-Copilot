# Development-only defaults. Override them in .env when needed.
LOG_LEVEL=INFO
MYSQL_DATABASE=local_life
MYSQL_USER=local_life
MYSQL_PASSWORD=local_life_dev
MYSQL_ROOT_PASSWORD=local_life_root_dev
MYSQL_PORT=13306
REDIS_PORT=6379
OPENSEARCH_PORT=19200
OPENSEARCH_PERFORMANCE_PORT=19600
OPENSEARCH_INDEX=local-life-chunks
OPENSEARCH_INDEX_VERSION=1
EMBEDDING_DIMENSION=512
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MODEL=local-deterministic-v1
KNOWLEDGE_DATA_ROOT=/data/knowledge
TRAINING_ARTIFACT_ROOT=/data/training/artifacts
MAX_INGESTION_SOURCE_BYTES=20971520
API_PORT=18000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MODEL_GATEWAY_HEALTH_URL=http://model-gateway:8001/health/live
MODEL_GATEWAY_EMBEDDING_URL=http://model-gateway:8001/v1/embeddings
# Local demo accounts only; override before first startup if the repository is shared.
DEMO_SEED_PASSWORD=local-life-demo-2026
# The three-class model artifact is mounted from backend/training/output/final_model.
SENTIMENT_MODEL=/models/sentiment
# Pin a commit/tag when SENTIMENT_MODEL is a Hugging Face model ID.
SENTIMENT_MODEL_REVISION=
JWT_SECRET_KEY=development-only-change-this-jwt-secret-key
JWT_ISSUER=local-life-copilot
JWT_AUDIENCE=local-life-copilot-api
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
